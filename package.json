{
  "name": "enterprise-data-analytics-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload --reload-dir backend/app",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "start": "npm run dev",
    "test:backend": "pytest backend",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
